{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndPushOnlyContactFormImage",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-1:203888389134:repository/contact-form",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-1"}}
    },
    {
      "Sid": "GetSingaporeEcrLoginToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-1"}}
    },
    {
      "Sid": "StartSessionOnOwnedRelay",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:ap-southeast-1:203888389134:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1",
          "ssm:resourceTag/Name": "contact-form-ssm-relay",
          "ssm:resourceTag/Project": "aws-contact-form-eks",
          "ssm:resourceTag/ManagedBy": "Terraform",
          "ssm:resourceTag/Lifecycle": "workload"
        },
        "BoolIfExists": {"ssm:SessionDocumentAccessCheck": "true"}
      }
    },
    {
      "Sid": "CheckOnlyRemoteHostForwardingDocument",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ssm:ap-southeast-1::document/AWS-StartPortForwardingSessionToRemoteHost"
    },
    {
      "Sid": "OpenSessionDataChannelInSingapore",
      "Effect": "Allow",
      "Action": "ssmmessages:OpenDataChannel",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-1"}}
    },
    {
      "Sid": "EndOwnSingaporeSession",
      "Effect": "Allow",
      "Action": "ssm:TerminateSession",
      "Resource": "arn:aws:ssm:ap-southeast-1:203888389134:session/${aws:username}-*"
    },
    {
      "Sid": "DiscoverSingaporeLoadBalancersAndTags",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTags"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-1"}}
    },
    {
      "Sid": "ReadAliasInHostedZone",
      "Effect": "Allow",
      "Action": "route53:ListResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z0153068M1DZTUZ2CE23"
    },
    {
      "Sid": "ChangeOnlyApexARecord",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z0153068M1DZTUZ2CE23",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": ["cheelong.xyz"],
          "route53:ChangeResourceRecordSetsRecordTypes": ["A"],
          "route53:ChangeResourceRecordSetsActions": ["CREATE", "DELETE"]
        },
        "Null": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": "false",
          "route53:ChangeResourceRecordSetsRecordTypes": "false",
          "route53:ChangeResourceRecordSetsActions": "false"
        }
      }
    },
    {
      "Sid": "WaitForAliasChange",
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    }
  ]
}
