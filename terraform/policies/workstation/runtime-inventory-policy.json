{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectDisposableRuntimeInSingapore",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeNatGateways",
        "ec2:DescribeAddresses",
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "ec2:DescribeSnapshots",
        "eks:ListClusters",
        "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots",
        "rds:DescribeDBInstanceAutomatedBackups",
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeListeners",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth",
        "elasticloadbalancing:DescribeTags",
        "ecr:DescribeRepositories",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "InspectRegionalKeyInventory",
      "Effect": "Allow",
      "Action": "kms:ListKeys",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "InspectRegionalKeyStatesAndOwnership",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey", "kms:ListResourceTags"],
      "Resource": "arn:aws:kms:ap-southeast-1:203888389134:key/*"
    },
    {
      "Sid": "ReadProjectFoundationalFindings",
      "Effect": "Allow",
      "Action": ["securityhub:GetFindings", "securityhub:GetEnabledStandards"],
      "Resource": "arn:aws:securityhub:ap-southeast-1:203888389134:hub/default"
    },
    {
      "Sid": "ReadProjectCertificateMetadata",
      "Effect": "Allow",
      "Action": "acm:DescribeCertificate",
      "Resource": "arn:aws:acm:ap-southeast-1:203888389134:certificate/90db0a99-25a4-4e6d-96e7-0bba09c7e426"
    },
    {
      "Sid": "ReadOwnManagedPolicyAttachments",
      "Effect": "Allow",
      "Action": "iam:ListAttachedUserPolicies",
      "Resource": "arn:aws:iam::203888389134:user/contact-form-deployer"
    },
    {
      "Sid": "ReadProjectTrailDelivery",
      "Effect": "Allow",
      "Action": ["cloudtrail:GetTrail", "cloudtrail:GetTrailStatus"],
      "Resource": "arn:aws:cloudtrail:ap-southeast-1:203888389134:trail/contact-form-management"
    },
    {
      "Sid": "ListSingaporeLogGroupMetadata",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "ReadProjectLogDeliveryTimestamps",
      "Effect": "Allow",
      "Action": "logs:FilterLogEvents",
      "Resource": [
        "arn:aws:logs:ap-southeast-1:203888389134:log-group:/aws/eks/contact-form-eks/cluster",
        "arn:aws:logs:ap-southeast-1:203888389134:log-group:/aws/rds/instance/contact-form-postgres/postgresql",
        "arn:aws:logs:ap-southeast-1:203888389134:log-group:/aws/rds/instance/contact-form-postgres/upgrade"
      ]
    },
    {
      "Sid": "ListProjectAlbAccessLogMetadata",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aws-contact-form-evidence-203888389134-ap-southeast-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": "service-logs/alb/*"
        }
      }
    }
  ]
}
