{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRetainedZone",
      "Effect": "Allow",
      "Action": ["route53:GetHostedZone", "route53:ListResourceRecordSets", "route53:ListTagsForResource"],
      "Resource": "arn:aws:route53:::hostedzone/Z0153068M1DZTUZ2CE23"
    },
    {
      "Sid": "ReadCertificateValidationChange",
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    },
    {
      "Sid": "ReadRetainedCertificate",
      "Effect": "Allow",
      "Action": ["acm:DescribeCertificate", "acm:ListTagsForCertificate"],
      "Resource": "arn:aws:acm:ap-southeast-1:203888389134:certificate/90db0a99-25a4-4e6d-96e7-0bba09c7e426"
    },
    {
      "Sid": "ReadRetainedEvidenceBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket", "s3:GetBucketLocation", "s3:GetBucketTagging",
        "s3:GetBucketPolicy", "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls", "s3:GetEncryptionConfiguration",
        "s3:GetBucketVersioning", "s3:GetLifecycleConfiguration",
        "s3:GetBucketAcl", "s3:GetBucketCORS", "s3:GetBucketWebsite",
        "s3:GetAccelerateConfiguration", "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging", "s3:GetReplicationConfiguration",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": "arn:aws:s3:::aws-contact-form-evidence-203888389134-ap-southeast-1"
    },
    {
      "Sid": "ReadAndToggleNamedConfigRecorder",
      "Effect": "Allow",
      "Action": [
        "config:DescribeConfigurationRecorders", "config:DescribeConfigurationRecorderStatus",
        "config:ListTagsForResource", "config:StartConfigurationRecorder",
        "config:StopConfigurationRecorder"
      ],
      "Resource": "arn:aws:config:ap-southeast-1:203888389134:configuration-recorder/contact-form-recorder/*"
    },
    {
      "Sid": "ReadSingaporeConfigDeliveryChannel",
      "Effect": "Allow",
      "Action": ["config:DescribeDeliveryChannels", "config:DescribeDeliveryChannelStatus"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-1"}}
    },
    {
      "Sid": "ReadAndToggleSingaporeSecurityHub",
      "Effect": "Allow",
      "Action": [
        "securityhub:DescribeHub", "securityhub:DescribeStandards",
        "securityhub:GetEnabledStandards", "securityhub:GetFindings",
        "securityhub:EnableSecurityHub", "securityhub:DisableSecurityHub",
        "securityhub:BatchEnableStandards", "securityhub:BatchDisableStandards"
      ],
      "Resource": "arn:aws:securityhub:ap-southeast-1:203888389134:hub/default"
    },
    {
      "Sid": "ReadNamedProjectTrail",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:GetTrail", "cloudtrail:GetTrailStatus",
        "cloudtrail:GetEventSelectors", "cloudtrail:GetInsightSelectors",
        "cloudtrail:ListTags"
      ],
      "Resource": "arn:aws:cloudtrail:ap-southeast-1:203888389134:trail/contact-form-management"
    },
    {
      "Sid": "ReadSingaporeTrailCollection",
      "Effect": "Allow",
      "Action": "cloudtrail:DescribeTrails",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-1"}}
    },
    {
      "Sid": "ReadSingaporeLogGroupCollection",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-southeast-1"}}
    },
    {
      "Sid": "ReadRetainedLogGroupTags",
      "Effect": "Allow",
      "Action": "logs:ListTagsForResource",
      "Resource": [
        "arn:aws:logs:ap-southeast-1:203888389134:log-group:/aws/eks/contact-form-eks/cluster",
        "arn:aws:logs:ap-southeast-1:203888389134:log-group:/aws/rds/instance/contact-form-postgres/postgresql",
        "arn:aws:logs:ap-southeast-1:203888389134:log-group:/aws/rds/instance/contact-form-postgres/upgrade"
      ]
    }
  ]
}
