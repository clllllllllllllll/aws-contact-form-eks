{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreatePrivateNamedCluster",
      "Effect": "Allow",
      "Action": "eks:CreateCluster",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "aws-contact-form-eks",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Lifecycle": "workload",
          "aws:RequestedRegion": "ap-southeast-1",
          "eks:authenticationMode": "API"
        },
        "Bool": {
          "eks:endpointPrivateAccess": "true",
          "eks:endpointPublicAccess": "false",
          "eks:bootstrapClusterCreatorAdminPermissions": "false",
          "eks:bootstrapSelfManagedAddons": "false"
        },
        "ForAllValues:ArnLike": {
          "eks:encryptionConfigProviderKeyArns": "arn:aws:kms:ap-southeast-1:203888389134:key/????????-????-????-????-????????????"
        },
        "Null": {
          "eks:encryptionConfigProviderKeyArns": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:UpdateClusterConfig",
        "eks:UpdateClusterVersion",
        "eks:DeleteCluster",
        "eks:UpdateAddon",
        "eks:DeleteAddon",
        "eks:UpdateNodegroupConfig",
        "eks:UpdateNodegroupVersion",
        "eks:DeleteNodegroup"
      ],
      "Resource": [
        "arn:aws:eks:ap-southeast-1:203888389134:cluster/contact-form-eks",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/vpc-cni/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/kube-proxy/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/coredns/*",
        "arn:aws:eks:ap-southeast-1:203888389134:nodegroup/contact-form-eks/contact-form-eks-0/*",
        "arn:aws:eks:ap-southeast-1:203888389134:nodegroup/contact-form-eks/contact-form-eks-1/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "aws-contact-form-eks",
          "aws:ResourceTag/Lifecycle": "workload"
        },
        "BoolIfExists": {
          "eks:endpointPrivateAccess": "true",
          "eks:endpointPublicAccess": "false"
        },
        "StringEqualsIfExists": {
          "eks:authenticationMode": "API"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:ListAccessEntries",
        "eks:ListAddons",
        "eks:ListNodegroups",
        "eks:ListUpdates",
        "eks:DescribeUpdate",
        "eks:DescribeAddon",
        "eks:DescribeNodegroup",
        "eks:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:eks:ap-southeast-1:203888389134:cluster/contact-form-eks",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/vpc-cni/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/kube-proxy/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/coredns/*",
        "arn:aws:eks:ap-southeast-1:203888389134:nodegroup/contact-form-eks/contact-form-eks-0/*",
        "arn:aws:eks:ap-southeast-1:203888389134:nodegroup/contact-form-eks/contact-form-eks-1/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:DescribeAccessEntry",
        "eks:ListAssociatedAccessPolicies"
      ],
      "Resource": "arn:aws:eks:ap-southeast-1:203888389134:access-entry/contact-form-eks/*/203888389134/contact-form-deployer/*"
    },
    {
      "Effect": "Allow",
      "Action": "eks:ListClusters",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:CreateAddon",
        "eks:CreateNodegroup"
      ],
      "Resource": "arn:aws:eks:ap-southeast-1:203888389134:cluster/contact-form-eks",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "aws-contact-form-eks",
          "aws:ResourceTag/Lifecycle": "workload",
          "aws:RequestTag/Project": "aws-contact-form-eks",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Lifecycle": "workload"
        }
      }
    },
    {
      "Sid": "CreateOnlyDeployerAccessEntry",
      "Effect": "Allow",
      "Action": "eks:CreateAccessEntry",
      "Resource": "arn:aws:eks:ap-southeast-1:203888389134:cluster/contact-form-eks",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "aws-contact-form-eks",
          "aws:ResourceTag/Lifecycle": "workload",
          "aws:RequestTag/Project": "aws-contact-form-eks",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Lifecycle": "workload",
          "eks:principalArn": "arn:aws:iam::203888389134:user/contact-form-deployer",
          "eks:accessEntryType": "STANDARD"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "eks:DeleteAccessEntry",
      "Resource": "arn:aws:eks:ap-southeast-1:203888389134:access-entry/contact-form-eks/*/203888389134/contact-form-deployer/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "aws-contact-form-eks",
          "aws:ResourceTag/Lifecycle": "workload",
          "eks:principalArn": "arn:aws:iam::203888389134:user/contact-form-deployer"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:AssociateAccessPolicy",
        "eks:DisassociateAccessPolicy"
      ],
      "Resource": "arn:aws:eks:ap-southeast-1:203888389134:access-entry/contact-form-eks/*/203888389134/contact-form-deployer/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "aws-contact-form-eks",
          "aws:ResourceTag/Lifecycle": "workload",
          "eks:principalArn": "arn:aws:iam::203888389134:user/contact-form-deployer",
          "eks:policyArn": "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "eks:TagResource",
      "Resource": [
        "arn:aws:eks:ap-southeast-1:203888389134:cluster/contact-form-eks",
        "arn:aws:eks:ap-southeast-1:203888389134:access-entry/contact-form-eks/*/203888389134/contact-form-deployer/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/vpc-cni/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/kube-proxy/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/coredns/*",
        "arn:aws:eks:ap-southeast-1:203888389134:nodegroup/contact-form-eks/contact-form-eks-0/*",
        "arn:aws:eks:ap-southeast-1:203888389134:nodegroup/contact-form-eks/contact-form-eks-1/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "aws-contact-form-eks",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Lifecycle": "workload"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "eks:TagResource",
        "eks:UntagResource"
      ],
      "Resource": [
        "arn:aws:eks:ap-southeast-1:203888389134:cluster/contact-form-eks",
        "arn:aws:eks:ap-southeast-1:203888389134:access-entry/contact-form-eks/*/203888389134/contact-form-deployer/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/vpc-cni/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/kube-proxy/*",
        "arn:aws:eks:ap-southeast-1:203888389134:addon/contact-form-eks/coredns/*",
        "arn:aws:eks:ap-southeast-1:203888389134:nodegroup/contact-form-eks/contact-form-eks-0/*",
        "arn:aws:eks:ap-southeast-1:203888389134:nodegroup/contact-form-eks/contact-form-eks-1/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "aws-contact-form-eks",
          "aws:ResourceTag/Lifecycle": "workload"
        }
      }
    }
  ]
}
