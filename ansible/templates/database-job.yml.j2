apiVersion: batch/v1
kind: Job
metadata:
  name: contact-form-db-setup-{{ image_uri.split(':')[-1][:12] }}
  namespace: contact-form
  labels:
    app.kubernetes.io/name: contact-form
    app.kubernetes.io/component: database-setup
spec:
  backoffLimit: 2
  template:
    metadata:
      labels:
        app.kubernetes.io/name: contact-form
        app.kubernetes.io/component: database-setup
    spec:
      serviceAccountName: contact-form-db-setup
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: setup
          image: {{ image_uri | to_json }}
          imagePullPolicy: IfNotPresent
          command: ["python", "/app/scripts/setup_database.py"]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 50m
              memory: 96Mi
            limits:
              cpu: 500m
              memory: 256Mi
          env:
            - name: AWS_REGION
              value: ap-southeast-1
            - name: DB_HOST
              value: {{ tf.rds_host.value | to_json }}
            - name: DB_PORT
              value: {{ (tf.rds_port.value | string) | to_json }}
            - name: DB_NAME
              value: {{ tf.rds_database_name.value | to_json }}
            - name: DB_MASTER_SECRET_ARN
              value: {{ tf.rds_master_secret_arn.value | to_json }}
            - name: APP_SECRET_ARN
              value: {{ tf.app_secret_arn.value | to_json }}
